        },
        {
            "name": "Debug PenningTrap",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "--particles",
                "10000"
            ],
            "stopAtEntry": false,
            "cwd": "/home/biddisco/build/grox",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "manualArgs",
            "type": "promptString",
            "description": "Enter arguments (will be split on spaces - quote multi-word values)",
            "default": ""
        }
    ]
}