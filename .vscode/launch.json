{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Python: Debug benchmark-grox",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarking/benchmark_grox.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Debug Active CMake Target",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/home/biddisco/build/grox/lib:/usr/local/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "visualizerFile": "/home/biddisco/.local/x86_64/config/Code/User/workspaceStorage/e176b59e3b294a02bf3a5933ee962988/tonka3000.qtvsctools/qt.natvis.xml"
        },
